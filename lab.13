<?php
echo "Enter first number: ";
$num1 = (float)readline();
echo "Enter second number: ";
$num2 = (float)readline();
echo "Enter an operator (+, -, *, /): ";
$operator = readline();
switch ($operator) {
    case '+':
        $result = $num1 + $num2;
        echo "Result: $num1 + $num2 = $result\n";
        break;
    case '-':
        $result = $num1 - $num2;
        echo "Result: $num1 - $num2 = $result\n";
        break;
    case '*':
        $result = $num1 * $num2;
        echo "Result: $num1 * $num2 = $result\n";
        break;
    case '/':
        // Handle division by zero condition
        if ($num2 == 0) {
            echo "Error: Division by zero is not allowed.\n";
        } else {
            $result = $num1 / $num2;
            echo "Result: $num1 / $num2 = $result\n";
        }
        break;
    default:
        echo "Invalid operator entered!\n";
        break;
}
?>
