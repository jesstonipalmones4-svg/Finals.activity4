<?php
echo "Enter traffic light color (red, yellow, green): ";
$color = readline();
$color = strtolower($color);

switch ($color) {
    case 'red':
        echo "Action: STOP\n";
        break;
    case 'yellow':
        echo "Action: SLOW DOWN / PREPARE TO STOP\n";
        break;
    case 'green':
        echo "Action: GO\n";
        break;
    default:
        echo "Invalid color! Please enter red, yellow, or green.\n";
        break;
}
?>
